# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/privacyguard

# Authentication
JWT_SECRET=privacyguard_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Microservices URLs
PYTHON_SERVICE_URL=http://localhost:8000
SAP_SERVICE_URL=http://localhost:5001

# AI Provider Configuration (Abstracted Layer)
# Supported options: "local" (Ollama/Mock), "gemini", "openai"
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# EmailJS API Configuration
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=


